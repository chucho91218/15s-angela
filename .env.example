# PIN para entrar al panel /admin. Usá al menos 6 dígitos.
ADMIN_PIN=
# Secreto que firma la sesión. Generalo con: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Opcional: carpeta donde se guardan las confirmaciones (por defecto, ./data).
# RSVP_DATA_DIR=
# Cloudflare lee estas mismas claves como secretos. En local van en .dev.vars.
